[Unit]
Description=Rclone one-way sync web controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/docker-compose/rclone-sync
ExecStart=/usr/bin/python3 /root/docker-compose/rclone-sync/app.py --host 0.0.0.0 --port 6096
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/docker-compose/rclone-sync /root/.config/rclone /home /media /mnt /srv /root/docker-compose/symedia
UMask=0077

[Install]
WantedBy=multi-user.target
